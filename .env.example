# Supabase Public Configuration (Accessible in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Server Privileged Key (Keep secret, never prefix with NEXT_PUBLIC)
# Either SUPABASE_SERVICE_ROLE_KEY or SUPABASE_SECRET_KEY is accepted
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# SUPABASE_SECRET_KEY=your-service-role-or-secret-key

# Application Base URL (Use http://localhost:3000 for local development, https://www.poabglobalconstruction.com in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production Transactional Email Configuration (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="POAB Website <notifications@poabglobalconstruction.com>"
NOTIFICATION_EMAIL=poabglobalconstruction@gmail.com
